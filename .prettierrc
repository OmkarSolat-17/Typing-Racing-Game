{
  "printWidth": 120,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSameLine": false,
  "endOfLine": "lf",
  "overrides": [
    { "files": ["*.md"], "options": { "proseWrap": "preserve" } },
    { "files": ["*.css"], "options": { "printWidth": 110 } }
  ]
}
