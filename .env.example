# KEYRUSH needs no secrets to build or run — this file documents the whole surface.
# Copy to `.env.local` for local overrides. Never commit a real value; `.env*` is gitignored.

# Optional build provenance label shown in the Home header (e.g. "canary", "team-build").
# Empty or unset = no badge is rendered.
VITE_BUILD_LABEL=

# Optional comma-separated origins allowed to embed the app (documentation only:
# the actual header is set by nginx in production — see nginx.conf's frame-ancestors).
VITE_ALLOWED_EMBED_ORIGINS=
